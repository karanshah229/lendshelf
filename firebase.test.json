{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test",
        "scripts",
        "src",
        "vitest.*.config.mts",
        "tsconfig*.json",
        "README.md"
      ]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "hub": { "host": "127.0.0.1", "port": 14400 },
    "logging": { "host": "127.0.0.1", "port": 14500 },
    "auth": { "host": "127.0.0.1", "port": 19099 },
    "firestore": { "host": "127.0.0.1", "port": 18080, "websocketPort": 19150 },
    "functions": { "host": "127.0.0.1", "port": 15001 },
    "storage": { "host": "127.0.0.1", "port": 19199 },
    "eventarc": { "host": "127.0.0.1", "port": 19299 },
    "tasks": { "host": "127.0.0.1", "port": 19499 },
    "ui": { "enabled": false }
  }
}
