rules_version = '2';

// LendShelf Storage rules. Custom book cover photos live at covers/{uid}/{fileName}.
service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        // Raster images only (no SVG: it can carry script).
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
