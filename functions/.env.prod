# Non-secret function settings for the "prod" alias (.firebaserc). Loaded by
# `firebase deploy --project prod` together with functions/.env (if any).
# Do NOT put secrets here: this file is committed. Use defineSecret instead.

# Reject callable requests without a valid App Check token. Keep false until
# the app ships with App Check (Play Integrity / App Attest) registered for
# this project, then set true and redeploy functions.
ENFORCE_APP_CHECK=false
