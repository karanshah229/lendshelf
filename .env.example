# Copy to .env.local (git-ignored) to override. `npm run dev:web` already sets EXPO_PUBLIC_USE_EMULATORS=1.

# Use the Firebase Emulator Suite (project demo-lendshelf).
EXPO_PUBLIC_USE_EMULATORS=1

# Host the emulators run on. Defaults: 127.0.0.1 (web, iOS simulator), 10.0.2.2 (Android emulator).
# Set to your computer's LAN IP to test on a physical phone.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.20

# Shift every emulator port by this amount (only if you run a second emulator set on other ports).
# EXPO_PUBLIC_EMULATOR_PORT_OFFSET=0
