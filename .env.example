# Copy to .env.local (git-ignored) to override.

# Which Firebase project the build talks to: dev (lendshelf-dev, the default) or prod
# (lendshelf-prod, never implicit). Read by app.config.ts when the app is bundled or prebuilt,
# usually set on the command line (e.g. `npx cross-env APP_ENV=prod expo run:android`).
# Config files come from firebase-config/<env>/ (`npm run firebase:config`).
# APP_ENV=dev

# Download link put in invite messages (UX §E2, open question H1: there is no store listing yet).
# Unset: invites say "Ask me for the app link" instead of a URL.
# EXPO_PUBLIC_INVITE_URL=https://example.com/lendshelf
